---
import { groupLabels, services, site, type ServiceGroup } from "../data/site";

const year = 2026;
const columns: ServiceGroup[] = ["mirada", "piel", "depilacion"];
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <p class="footer__name">Victoria Rivera<br />Studio</p>
      <p class="footer__meta">
        {site.city}, Región de {site.region}<br />
        <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a><br />
        <a href={site.instagram} rel="noopener noreferrer" target="_blank">{site.handle}</a>
      </p>
    </div>
    {
      columns.map((group) => (
        <div>
          <h2>{groupLabels[group]}</h2>
          <ul>
            {services
              .filter((service) => service.group === group)
              .map((service) => (
                <li>
                  <a href={`/servicios/${service.slug}/`}>{service.name}</a>
                </li>
              ))}
            {group === "depilacion" && (
              <>
                <li>
                  <a href="/servicios/masajes-piedras-calientes-ovalle/">Masajes piedras calientes</a>
                </li>
                <li>
                  <a href="/agenda/">Agendar hora</a>
                </li>
              </>
            )}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="wrap footer__legal">
    <p>
      © {year} {site.name}. La dirección en Ovalle se confirma al agendar. Resultados según tu piel y tu pestaña.
    </p>
  </div>
</footer>
