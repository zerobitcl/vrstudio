---
import Base from "../layouts/Base.astro";
import {
  areas,
  defaultWa,
  faqJsonLd,
  formatPrice,
  gallery,
  groupLabels,
  homeFaqs,
  services,
  site,
  waLink,
  type ServiceGroup,
} from "../data/site";

const order: ServiceGroup[] = ["mirada", "piel", "depilacion", "cuerpo"];
const paths = [
  {
    title: "Lash lifting",
    text: "Tradicional o coriano, sobre tu pestaña.",
    points: ["Desde $20.000", "Coriano con color $30.000", "Sin extensiones"],
    href: "/servicios/lash-lifting-ovalle/",
    tone: "rose",
    n: "01",
  },
  {
    title: "Brow lamination",
    text: "Cejas ordenadas, con o sin diseño.",
    points: ["Desde $20.000", "Con diseño $25.000", "Tinte de regalo en el pack"],
    href: "/servicios/laminado-de-cejas-ovalle/",
    tone: "gold",
    n: "02",
  },
  {
    title: "Limpieza facial",
    text: "Express o profunda, según tu piel.",
    points: ["Express $25.000", "Profunda $30.000", "Protocolo de estudio"],
    href: "/servicios/limpieza-facial-ovalle/",
    tone: "blush",
    n: "03",
  },
];

let index = 0;
---

<Base
  title="Lash lifting y estética facial en Ovalle"
  description="Lash lifting, laminado de cejas, limpieza facial y epilación hindú en Ovalle. Precios publicados. Victoria Rivera Studio, Valle del Limarí."
  jsonLd={faqJsonLd(homeFaqs)}
>
  <section class="hero wrap">
    <div class="hero__copy">
      <p class="kicker">Estudio de mirada y piel · Ovalle</p>
      <h1>Lash lifting y estética facial <em>en Ovalle</em></h1>
      <p class="lead hero__lead">
        Laminado de cejas, limpieza facial, epilación hindú y masajes.
        Técnica de lashista profesional para una mirada más abierta, con precios claros.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={waLink(defaultWa)}>Agendar hora</a>
        <a class="btn btn--ghost" href="#precios">Ver precios</a>
      </div>
      <p class="hero__note">
        WhatsApp {site.phoneDisplay} · también desde Monte Patria, Punitaqui y el resto del Limarí.
        <a href={site.instagram} rel="noopener noreferrer" target="_blank">Ver el trabajo en Instagram</a>
      </p>
    </div>
    <div class="orb">
      <figure class="hero__shot">
        <img
          src={gallery[0].src}
          alt={gallery[0].alt}
          width="720"
          height="900"
          loading="eager"
          decoding="async"
        />
        <figcaption>{gallery[0].caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap" aria-label="Datos del estudio">
    <div class="facts">
      <div>
        <strong>Precios a la vista</strong>
        <span>Lista publicada, para agendar con tranquilidad.</span>
      </div>
      <div>
        <strong>Ovalle</strong>
        <span>Valle del Limarí, Región de Coquimbo.</span>
      </div>
      <div>
        <strong>Atención personal</strong>
        <span>Victoria Rivera Studio · @vr.studio_oficial</span>
      </div>
      <div>
        <strong>WhatsApp</strong>
        <span>La hora se confirma en el chat.</span>
      </div>
    </div>
  </section>

  <section class="section wrap" id="mirada">
    <div class="section__head">
      <p class="section__index">01</p>
      <h2>Elige la mirada <em>que buscas</em></h2>
      <p>Tres caminos con precio a la vista. Si dudas entre tradicional y coriano, escríbenos antes de agendar.</p>
    </div>
    <div class="choice">
      {
        paths.map((path) => (
          <article class={`choice__card choice__card--${path.tone}`}>
            <span class="choice__n" aria-hidden="true">{path.n}</span>
            <h3>{path.title}</h3>
            <p>{path.text}</p>
            <ul>
              {path.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <a class="btn btn--ghost" href={path.href}>
              Ver {path.title.toLowerCase()}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="resultado">
    <div class="section__head">
      <p class="section__index">02</p>
      <h2>Resultado real <em>del estudio</em></h2>
      <p>
        Lash lifting coriano, brow lamination con diseño y tinte, y epilación hindú. Trabajo real del estudio en Ovalle.
      </p>
    </div>
    <div class="gallery">
      {
        gallery.map((shot) => (
          <figure class:list={[{ "is-compact": shot.size === "compact" }]}>
            <img
              src={shot.src}
              alt={shot.alt}
              width={shot.size === "compact" ? 480 : 720}
              height={shot.size === "compact" ? 480 : 900}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{shot.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="precios">
    <div class="section__head">
      <p class="section__index">03</p>
      <h2>Precios <em>en Ovalle</em></h2>
      <p>
        Lista del estudio. Cera y láser se confirman por WhatsApp.
      </p>
    </div>
    <div class="priceboard">
      {
        order.map((group) => {
          const items = services.filter((service) => service.group === group);
          return (
            <div class="priceboard__block">
              <p class="menu__label">{groupLabels[group]}</p>
              {items.map((service) => {
                if (service.variants?.length) {
                  return service.variants.map((variant) => (
                    <a class="price-row" href={`/servicios/${service.slug}/`}>
                      <span>
                        <span class="price-row__name">{variant.name}</span>
                        {variant.note && <span class="price-row__note">{variant.note}</span>}
                      </span>
                      <span class="price-row__value">
                        {variant.price != null ? formatPrice(variant.price) : "Consultar"}
                      </span>
                    </a>
                  ));
                }
                return (
                  <a class="price-row" href={`/servicios/${service.slug}/`}>
                    <span>
                      <span class="price-row__name">{service.name}</span>
                      {service.priceNote && <span class="price-row__note">{service.priceNote}</span>}
                    </span>
                    <span class="price-row__value">
                      {service.price != null ? formatPrice(service.price) : "Consultar"}
                    </span>
                  </a>
                );
              })}
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="section wrap" id="tratamientos">
    <div class="section__head">
      <p class="section__index">04</p>
      <h2>Tratamientos <em>del estudio</em></h2>
      <p>Cada uno tiene su página para quien busca en Google desde Ovalle o el Limarí.</p>
    </div>
    <div class="menu">
      {
        order.map((group) => (
          <>
            <p class="menu__label">{groupLabels[group]}</p>
            {services
              .filter((service) => service.group === group)
              .map((service) => {
                index += 1;
                return (
                  <a class="row" href={`/servicios/${service.slug}/`}>
                    <span class="row__i">{String(index).padStart(2, "0")}</span>
                    <span>
                      <span class="row__name">{service.name}</span>
                      <span class="row__desc">
                        {service.menu}
                        {service.price != null ? ` · desde ${formatPrice(service.price)}` : ""}
                      </span>
                    </span>
                    <span class="row__go" aria-hidden="true">→</span>
                  </a>
                );
              })}
          </>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="limari">
    <div class="section__head">
      <p class="section__index">05</p>
      <h2>Ovalle y el <em>Valle del Limarí</em></h2>
      <p>
        La atención es en Ovalle, a unos 90 kilómetros de La Serena. Si vienes desde otra comuna, la hora se deja lista por WhatsApp.
      </p>
    </div>
    <div class="zones">
      {
        areas.map((area, i) => (
          <article class:list={["zone", { "zone--main": i === 0 }]}>
            <h3>{area.name}</h3>
            <p>{area.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="preguntas">
    <div class="section__head">
      <p class="section__index">06</p>
      <h2>Preguntas <em>antes de agendar</em></h2>
    </div>
    <div class="faq">
      {
        homeFaqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <div class="closer">
      <img class="closer__logo" src="/logo-mark.png" width="88" height="88" alt="" />
      <p class="sign">Victoria</p>
      <p class="kicker">Ovalle · Valle del Limarí</p>
      <h2>Agenda tu hora.</h2>
      <p>
        Escribe el tratamiento y el día que te acomoda. Respondemos por WhatsApp al {site.phoneDisplay}.
      </p>
      <a class="btn btn--light" href={waLink(defaultWa)}>Agendar por WhatsApp</a>
    </div>
  </section>
</Base>
