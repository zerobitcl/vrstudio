---
import Base from "../../layouts/Base.astro";
import { formatPrice, groupLabels, services, site, type ServiceGroup } from "../../data/site";

const order: ServiceGroup[] = ["mirada", "piel", "depilacion", "cuerpo"];
---

<Base
  title="Tratamientos y precios en Ovalle"
  description="Lash lifting, laminado de cejas, limpieza facial, epilación hindú y más en Ovalle. Precios publicados. Victoria Rivera Studio."
>
  <section class="service-hero wrap">
    <div>
      <p class="kicker">Tratamientos · {site.city}</p>
      <h1>Mirada, piel y cuerpo <em>en el estudio</em></h1>
      <p class="lead">
        Menú completo con precios. Elige el tratamiento y agenda por WhatsApp. Cera y láser se confirman en el chat.
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: 3rem">
    <div class="menu">
      {
        order.map((group) => (
          <>
            <p class="menu__label">{groupLabels[group]}</p>
            {services
              .filter((service) => service.group === group)
              .map((service, i) => (
                <a class="row" href={`/servicios/${service.slug}/`}>
                  <span class="row__i">{String(i + 1).padStart(2, "0")}</span>
                  <span>
                    <span class="row__name">{service.name}</span>
                    <span class="row__desc">
                      {service.menu}
                      {service.price != null
                        ? ` · desde ${formatPrice(service.price)}`
                        : " · consultar"}
                    </span>
                  </span>
                  <span class="row__go" aria-hidden="true">→</span>
                </a>
              ))}
          </>
        ))
      }
    </div>
  </section>
</Base>
